-- 6) Difference in Amount between Payment methods

select sum(Amount) as total_Amount,Payment_Method,(select sum(Amount) from final_rental) as overall_total,
sum(Amount)*100/(select sum(Amount) from final_rental) as percentage_difference from final_rental
group by Payment_Method 
order by sum(Amount) desc;

-- 7) Customers with Amount greatrer than Average Amount

select Customer_ID,sum(Amount) as 'total amount',(select round(avg(Amount),2) from final_rental) 'average amount'
 from  final_rental
group by Customer_ID 
having sum(Amount)>avg(Amount);

-- 8) Revenue over month

select date_format(Payment_Date,'%Y-%m') month,
sum(Amount) as 'Monthly Revenue' from final_rental
 group by month
order by month
;

-- 9) Monthly Revenue Difference/Trend

select date_format(Payment_Date,'%Y-%m') as month,
sum(Amount) as 'Monthly Revenue',
sum(Amount)-LAG(sum(Amount)) over( order by date_format(Payment_Date,'%Y-%m') desc) as 'sales difference'
from final_rental
group by date_format(Payment_Date,'%Y-%m');




