create table final_rental as
select r.*,c.name,c.phone,c.Membership_Status,p.Payment_ID,p.Payment_Date,p.Amount,p.Payment_Method,v.Make,v.Model,v.Year,v.Daily_Rate,v.Status_of_rental,v.Status_Date,v.img,m.`img URL`
from rentals2 as r
left join customer2 as c
on r.Customer_ID=c.Customer_ID
left join payments2 as p
on r.Rental_ID=p.Rental_ID
left join vehicles2 as v
on v.Vehicle_ID=r.Vehicle_ID
left join makes2 as m
on m.Make=v.Make;

