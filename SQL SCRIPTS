-- 4) Month wise Revenue Generation

select date_format(Payment_Date,'%Y-%m') as month,
sum(Amount) as monthly_Revenue
from final_rental
group by month
order by month;


-- 5) Sales growth month wise

select month,monthlyRevenue,lag(monthlyRevenue)over(order by month) as previous_month,
(monthlyRevenue-lag(monthlyRevenue)over(order by month))
/
lag(monthlyRevenue)over(order by month)*100
as growth_percentage from(
select date_format(Payment_Date,'%Y-%m') as month,sum(Amount) as monthlyRevenue from 
final_rental group by month
)t;

