-- 3) % Contribution from each Membership Status
SELECT 
    Membership_Status,
    (select sum(Amount) from final_rental) overall_amount,
    SUM(Amount) AS total_amount,
    round(SUM(Amount) * 100 / (SELECT SUM(Amount) FROM final_rental),2) AS percentage
FROM final_rental
